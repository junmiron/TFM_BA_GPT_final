# Copy to .env (never committed) and fill in.
# The app reads these keys through src/model_loader.py.

# Which model profile to use: openai | openai_npt | ollama | lmstudio | onnx | azure | groq | hugging | github
# This project ships the LM Studio profile: src/model_config_lmstudio.yaml
#   MODEL_CLIENT=lmstudio
# NOTE: the model name in that profile must match a downloaded LM Studio model
# (run `lms ls` and copy the identifier, e.g. "qwen3.8-27b"). For other
# backends copy src/model_config_template.yaml and tune its fields.
MODEL_CLIENT=lmstudio
# Profile for the agents that call tools (parallel_tool_calls disabled).
# Use the same LM Studio profile as the main client: no key needed.
# Alternatively MODEL_CLIENT_TOOLS=openai_npt with a real OPENAI_API_KEY.
MODEL_CLIENT_TOOLS=lmstudio

OPENAI_API_KEY=sk-you…_key
# AZURE_OPENAI_API_KEY=your-azure-key
# GROQ_API_KEY=your-groq-key
# HF_TOKEN=your-huggingface-token
# GITHUB_TOKEN=your-github-token

# Max chat messages before the workflow is force-stopped (safety net).
MAX_MESSAGES=300
