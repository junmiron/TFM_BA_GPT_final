# Copy to .env (never committed) and fill in.
# src/model_loader.py reads this file at import time.
#
# Standard: every profile lives in src/model_config_<name>.yaml and holds only
# provider, host and model. No YAML carries a key - keys live here only.

# --- Model selector -----------------------------------------------------------
# Pick any profile: openai | openai_npt | azure | groq | hugging | github |
#                   opencode | lmstudio | strata | ollama | onnx
MODEL_CLIENT=strata              # lane the BA agents run on
MODEL_CLIENT_TOOLS=strata        # lane the tool-calling agents run on
HUMAN_MODEL=opencode             # lane the simulated stakeholder runs on

# --- Keys (the only place secrets are stored) -------------------------------
OPENAI_API_KEY=sk-you…_key
# AZURE_OPENAI_API_KEY=your-azure-key
# GROQ_API_KEY=your-groq-key
# HF_TOKEN=your-huggingface-token
# GITHUB_TOKEN=your-github-token
# OPENCODE_GO_API_KEY=your-opencode-go-key

# --- Run limits ---------------------------------------------------------------
MAX_MESSAGES=300
# How many times the checker may bounce a missing template section back to
# the writer before finalize fills the gap from the document itself (3 by default).
MAX_CHECKER_ROUNDS=3
SIMULATE_HUMAN=false

# --- Feedback / reinforcement learning (Feature 1) ---------------------------
# Ask the user whether they are happy with the deliverables at the end of a
# run. 'Yes' feeds the deliverables into the approved_experiences ChromaDB
# collection, appends the session to experiences/reinforcement_learning.md
# and writes a fine-tune example under experiences/fine_tune/. 'No' stores
# the critique in feedback/<session_id>.md instead. Silence indexes nothing.
FEEDBACK_ENABLED=true
# Seconds to wait for the satisfaction answer before giving up.
FEEDBACK_TIMEOUT_S=300
# ChromaDB collection for approved deliverables (shares CHROMA_DIR).
RAG_APPROVED_COLLECTION=approved_experiences

# --- UI visibility switches (Feature 2) --------------------------------------
# false hides the Artifacts panel in the right rail.
UI_SHOW_ARTIFACTS=true
# false shows only the interviewer/user conversation (agent planning, writer
# and checker chatter stays in the backend event log for audit).
UI_SHOW_INTERNAL_MESSAGES=true

# Identifies this app to libraries that log a user agent (sentence-transformers
# downloads and scraper helpers).
USER_AGENT=TFM_BA_GPT/1.0

# --- Optional overrides -------------------------------------------------------
# Point a profile at another host or model without editing its YAML:
# STRATA_BASE_URL=http://127.0.0.1:47831/v1
# STRATA_MODEL=q2_0
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=qwen3.8-27b
