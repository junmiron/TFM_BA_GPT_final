# Copy to .env (never committed) and fill in.
# The app reads these keys through src/model_loader.py.

# Which model profile to use: openai | openai_npt | ollama | lmstudio | onnx | azure | groq | hugging | github
MODEL_CLIENT=openai

OPENAI_API_KEY=sk-you…_key
# AZURE_OPENAI_API_KEY=your-azure-key
# GROQ_API_KEY=your-groq-key
# HF_TOKEN=your-huggingface-token
# GITHUB_TOKEN=your-github-token

# Max chat messages before the workflow is force-stopped (safety net).
MAX_MESSAGES=300
