%% Functional Specification Diagram
flowchart TD
    %% Subgraph for User Interactions
    subgraph UserFlow["User Interactions"]
        direction TB
        A[Visit Homepage] --> B[Search Products]
        B --> C[View Products]
        C -->|Choose Product| D[View Product Details]
        D -->|Add to Wishlist| E[Wishlist]
        D -->|Add to Cart| F[Shopping Cart]
