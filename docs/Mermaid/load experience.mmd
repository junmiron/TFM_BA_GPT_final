%% Inicio con carga de experiencia (tool entre agente y episodic)
Astart --> A0
A0 --> L1
L1 --> M2
A0 --> F4
A0 --> A1

%% Orquestacion por planner + selector
A1 --> A2
A2 --> A3
A2 --> A5
A2 --> A6
A2 --> A7
A2 --> A8
A2 --> A9
A2 --> A10

%% Interviewer
A3 --> A4
A3 --> T1
T1 --> F1
A3 --> M1

%% Summarizer -> decision de aprobacion
A5 --> M1
A5 --> DAPP
DAPP -- Si --> A6
DAPP -- No --> A3

%% Writer: agent tools + escritura MD
A6 --> M1
A6 --> AT1
AT1 --> A6
A6 --> AT2
AT2 --> A6
A6 --> T3
T3 --> F2

%% Checker: lectura MD + decision de completitud
A7 --> T2
T2 --> F2
A7 --> M1
A7 --> DCHK
DCHK -- Si --> A8
DCHK -- NEEDS_INFO user --> A3
DCHK -- NEEDS_INFO UC/Glosario --> A6

%% Diagram creator: lee MD y escribe en Canvas
A8 --> T2
A8 --> C1
C1 --> M3

%% Reviewer: itera en Canvas y commit final
A9 --> C1
A9 --> DREV
DREV -- Si --> T4
DREV -- No --> A8
T4 --> F3

%% Terminate pipeline
F1 --> A10
F2 --> A10
F3 --> A10
A10 --> E1
E1 --> F4
A10 --> E2
E2 --> F4
A10 --> E3
E3 --> F4
A10 --> E4
E4 --> F4
A10 --> E5
E5 --> M2
A10 --> Aend

%% Contenido del directorio experience/<SESSION_ID>/
F4 --> FX1
F4 --> FX2
F4 --> FX3
F4 --> FX4

%% Consumo de RAG por agent tools
AT1 --> M1
AT2 --> M1
